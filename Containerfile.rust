ARG BASE_IMAGE=docker.io/library/rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
FROM ${BASE_IMAGE}

ARG REVISION
ARG SOURCE

LABEL org.opencontainers.image.source=${SOURCE}
LABEL org.opencontainers.image.revision=${REVISION}
LABEL org.opencontainers.image.description="Public Rust build environment"

RUN apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        libssl-dev \
        openssh-client \
        pkg-config \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add --toolchain "$RUST_VERSION" clippy rustfmt \
    && cargo --version \
    && rustc --version
